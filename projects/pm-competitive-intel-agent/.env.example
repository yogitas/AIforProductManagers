# GEMINI API Key (Acquired from Google AI Studio)
LLM_API_KEY="your-gemini-api-key-here"

# SMTP E-Mail configuration for Daily Digest delivery (Required if not dry-running)
SMTP_USERNAME="your-sender-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
REPORT_TO_EMAIL="recipient-email@example.com"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=465
